<Window x:Class="AIUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">

    <Window.Resources>
        <Style x:Key="WidgetTooltipCard" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F818181A"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                MinWidth="220">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header: Tool Title -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding FullName}" Foreground="#FFFFFF"
                                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                                    <Border Background="#30FFFFFF" CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding ResetVisibility}">
                                        <TextBlock Text="{Binding Row1ResetText}" Foreground="#EAEAEA"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Subtitle / Account Detail -->
                                <TextBlock Text="{Binding DetailText}" Foreground="#B0B0B8"
                                           FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                           Visibility="{Binding DetailVisibility}"/>

                                <Rectangle Height="1" Fill="#30FFFFFF" Margin="0,2,0,8"
                                           Visibility="{Binding RowsVisibility}"/>

                                <!-- Fallback / Status message (when no limit data) -->
                                <TextBlock Text="{Binding FallbackText}" Foreground="#F0F0F0"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,2"
                                           Visibility="{Binding FallbackVisibility}"/>

                                <!-- 5h Limit Row -->
                                <StackPanel Margin="0,3" Visibility="{Binding Row1Visibility}">
                                    <Grid>
                                        <TextBlock Text="5-Hour Window" Foreground="#D0D0D0" FontSize="12" FontWeight="Medium"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding Row1Text}" Foreground="{Binding Row1Brush}"
                                                   FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Row1ResetFull}" Foreground="#9E9EA6"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Weekly Limit Row -->
                                <StackPanel Margin="0,6,0,2" Visibility="{Binding Row2Visibility}">
                                    <Grid>
                                        <TextBlock Text="Weekly Window" Foreground="#D0D0D0" FontSize="12" FontWeight="Medium"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding Row2Text}" Foreground="{Binding Row2Brush}"
                                                   FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Row2ResetFull}" Foreground="#9E9EA6"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="6" Background="#D01F1F1F"
            BorderBrush="#30FFFFFF" BorderThickness="1" Padding="8,2">
        <ItemsControl x:Name="ToolsList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,0"
                                Visibility="{Binding Visibility}"
                                ToolTipService.Placement="Top"
                                ToolTipService.VerticalOffset="-8"
                                ToolTipService.InitialShowDelay="100"
                                ToolTipService.BetweenShowDelay="0"
                                ToolTipService.ShowDuration="60000">
                        <StackPanel.ToolTip>
                            <ToolTip Style="{StaticResource WidgetTooltipCard}"/>
                        </StackPanel.ToolTip>
                        <TextBlock Text="|" Foreground="#50FFFFFF" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding SeparatorVisibility}"/>
                        <TextBlock Text="{Binding Name}" Foreground="#909090"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <!-- fallback (no percentage data) -->
                        <TextBlock Text="{Binding FallbackText}" Foreground="LightGray"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                   Visibility="{Binding FallbackVisibility}"/>

                        <!-- 5h / weekly rows -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding RowsVisibility}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="5h" Foreground="#808080" FontSize="9"
                                           Width="15" VerticalAlignment="Center"/>
                                <Grid Height="4" Width="{Binding BarTrackWidth}" VerticalAlignment="Center">
                                    <Border Background="#40FFFFFF" CornerRadius="2"/>
                                    <Border Background="{Binding Row1Brush}" CornerRadius="2"
                                            HorizontalAlignment="Left" Width="{Binding Row1BarWidth}"/>
                                </Grid>
                                <TextBlock Text="{Binding Row1Text}" Foreground="{Binding Row1Brush}"
                                           FontSize="9" FontWeight="Bold"
                                           Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="wk" Foreground="#808080" FontSize="9"
                                           Width="15" VerticalAlignment="Center"/>
                                <Grid Height="4" Width="{Binding BarTrackWidth}" VerticalAlignment="Center">
                                    <Border Background="#40FFFFFF" CornerRadius="2"/>
                                    <Border Background="{Binding Row2Brush}" CornerRadius="2"
                                            HorizontalAlignment="Left" Width="{Binding Row2BarWidth}"/>
                                </Grid>
                                <TextBlock Text="{Binding Row2Text}" Foreground="{Binding Row2Brush}"
                                           FontSize="9" FontWeight="Bold"
                                           Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- compact circular gauges (5h + wk) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding CircleVisibility}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock Text="5h" Foreground="#808080" FontSize="9"
                                           VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <Grid Width="24" Height="24">
                                    <Ellipse Width="20" Height="20" Stroke="#40FFFFFF" StrokeThickness="4"/>
                                    <Path Data="{Binding Ring1Geometry}" Stroke="{Binding Ring1Brush}"
                                          StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="{Binding Ring1CenterText}" Foreground="{Binding Ring1Brush}"
                                               FontSize="8" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="wk" Foreground="#808080" FontSize="9"
                                           VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <Grid Width="24" Height="24">
                                    <Ellipse Width="20" Height="20" Stroke="#40FFFFFF" StrokeThickness="4"/>
                                    <Path Data="{Binding Ring2Geometry}" Stroke="{Binding Ring2Brush}"
                                          StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="{Binding Ring2CenterText}" Foreground="{Binding Ring2Brush}"
                                               FontSize="8" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- 5h reset countdown, centered like the tool name (both modes) -->
                        <TextBlock Text="{Binding Row1ResetText}" Foreground="#909090"
                                   FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                                   VerticalAlignment="Center" Visibility="{Binding ResetVisibility}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
